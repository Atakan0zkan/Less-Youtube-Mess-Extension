{
  "name": "less-youtube-mess",
  "version": "1.8.5",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Less Youtube Mess — Chrome MV3 extension (AI-less, zero-dependency tests)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "test:regression": "node --test tests/regression.test.cjs",
    "test:comprehensive": "node --test tests/comprehensive.test.cjs",
    "test:localization": "node --test tests/localization.test.cjs",
    "test:security": "node --test tests/security.test.cjs",
    "test:licensing": "node --test tests/licensing.test.cjs",
    "test:performance": "node --test tests/performance.test.cjs",
    "test:release": "node tests/release.cjs",
    "test:release:offline": "node tests/release.cjs --offline",
    "test:release:live": "node tests/release.cjs --live",
    "test:e2e": "node tests/browser-smoke.cjs",
    "test:e2e:localization": "node tests/browser-smoke.cjs --localization",
    "test:e2e:live": "node tests/browser-smoke.cjs --live",
    "check": "node tests/check.cjs"
  }
}
