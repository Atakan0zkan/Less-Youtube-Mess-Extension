{
  "manifest_version": 3,
  "name": "Less Youtube Mess",
  "description": "Customize YouTube: Hide Shorts, Sidebar, Comments, Recommendations, and More!",
  "version": "1.6.6",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Less Youtube Mess",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "css": ["styles.css"],
      "js": ["shared/constants.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["storage"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
